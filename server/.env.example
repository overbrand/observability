# Central stack environment — paste into Dokploy (Environment tab).

# Public names (DNS A records → the Dokploy server).
GRAFANA_DOMAIN=grafana.overbrand.net
INGEST_DOMAIN=ingest.overbrand.net

# Grafana's local admin (keep it even with Logto: it is the way in if SSO breaks).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# One htpasswd entry per agent, comma-separated, in SINGLE quotes ($ stays literal).
# Each comes from scripts/ingest-user.sh <agent-name>.
INGEST_USERS='eventez-vps:$2y$05$...,bns-staging:$2y$05$...,bns-aks:$2y$05$...'

# Alerts. Telegram: create a bot with @BotFather, add it to each group, and
# read the group's chat id (a negative number) from
# https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_OPS=
EMAIL_OPS=
# Per project (empty → the ops chat and address).
TELEGRAM_CHAT_BNS=
EMAIL_BNS=
TELEGRAM_CHAT_EVENTEZ=
EMAIL_EVENTEZ=

# SMTP for the alert e-mails.
SMTP_SMARTHOST=smtp.example.com:587
SMTP_FROM=alerts@overbrand.net
SMTP_USERNAME=
SMTP_PASSWORD=

# Dead man's switch (recommended): a healthchecks.io check URL that expects a
# ping every minute and alerts you when the monitoring itself goes quiet.
HEARTBEAT_URL=

# Retention.
METRICS_RETENTION=30d
METRICS_RETENTION_SIZE=20GB
LOGS_RETENTION=336h

# Grafana sign-in with Logto (optional). Create a "Traditional web" app in
# Logto: redirect URI https://<GRAFANA_DOMAIN>/login/generic_oauth, post
# sign-out redirect URI https://<GRAFANA_DOMAIN>/login; then
# give people the role grafanaAdmin or grafanaEditor (anyone else: Viewer).
LOGTO_ENABLED=false
LOGTO_ENDPOINT=https://auth.overbrand.net
LOGTO_CLIENT_ID=
LOGTO_CLIENT_SECRET=
