# Which project and environment this machine belongs to (a container can
# override with the labels overbrand.project / overbrand.env).
PROJECT=eventez
ENV=production
# How this machine is named in Grafana.
HOST_NAME=eventez-vps
# Central ingest (defaults shown).
PROMETHEUS_URL=https://ingest.overbrand.net/api/v1/write
LOKI_URL=https://ingest.overbrand.net/loki/api/v1/push
# This machine's credential: scripts/ingest-user.sh <name> prints both the
# password and the line to add to the central INGEST_USERS.
INGEST_USER=
INGEST_PASSWORD=
